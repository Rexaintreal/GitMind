{
  "compilerOptions": {
    "module":           "Node16",
    "target":           "ES2022",
    "outDir":           "out",
    "lib":              ["ES2022", "DOM"],
    "sourceMap":        true,
    "rootDir":          "src",
    "strict":           true,
    "moduleResolution": "Node16",
    "skipLibCheck":     true
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"]
}
