{
  "name": "gitmind",
  "displayName": "GitMind",
  "description": "AI-powered git assistant for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
],
  "main": "./out/extension.js",
"contributes": {
    "commands": [
        { "command": "gitmind.start", "title": "GitMind: Start" },
        { "command": "gitmind.stop", "title": "GitMind: Stop" },
        { "command": "gitmind.pause", "title": "GitMind: Pause" },
        { "command": "gitmind.commitNow", "title": "GitMind: Commit Now" },
        { "command": "gitmind.showPanel", "title": "GitMind: Show Panel" }
    ],
    "viewsContainers": {
        "activitybar": [
            {
                "id": "gitmind-sidebar",
                "title": "GitMind",
                "icon": "media/gitmind-icon.svg"
            }
        ]
    },
    "views": {
        "gitmind-sidebar": [
            {
                "icon": "media/gitmind-icon.svg",
                "type": "webview",
                "id": "gitmind.sidebar",
                "name": "GitMind"
            }
        ]
    }
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
